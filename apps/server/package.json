{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:backup": "bun scripts/backup.ts",
    "db:restore": "bun scripts/restore.ts",
    "admin:grant": "bun scripts/admin.ts grant",
    "admin:revoke": "bun scripts/admin.ts revoke",
    "admin:list": "bun scripts/admin.ts list",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@the-water/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "nodemailer": "^10.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
