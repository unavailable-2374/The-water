# ---- 基础 ----
PORT=8787
DATABASE_URL=./data/dev.sqlite
# 站外分享用的绝对地址（作品页 /n/:id、作者页 /u/:handle 的 og:url / og:image、
# canonical、sitemap、RSS 都据此生成）。留空则按当前请求的 origin 推导。
# 注意：这里的端口要和上面的 PORT 一致，否则分享链接会指向一个没有服务的端口。
PUBLIC_BASE_URL=http://localhost:8787
EXTRA_ORIGINS=

# ---- 反向代理 ----
# TRUST_PROXY=1 且来源 IP 命中 TRUSTED_PROXIES 时才采信 X-Forwarded-For。
# 只开 TRUST_PROXY 而不配可信列表，等于让任何人自称任意 IP（绕过限流与浏览去重）。
TRUST_PROXY=0
TRUSTED_PROXIES=

# ---- 管理员 ----
# 逗号分隔。仅当该邮箱**已完成验证**时才生效（见 P0-3），且名单非空时它是权威来源：
# 用 `bun run admin:grant` 授予但不在名单里的管理员，下次登录会被降级。
ADMIN_EMAILS=

# ---- 邮件（找回密码 / 邮箱验证 / 注销确认）----
# console 只打印到日志（开发用）；生产必须换成 smtp 或 resend，否则用户忘记密码就永久失联。
MAIL_TRANSPORT=console
MAIL_FROM=The Water <no-reply@localhost>
# MAIL_TRANSPORT=smtp 时必填，形如 smtps://user:pass@smtp.example.com:465
SMTP_URL=
# MAIL_TRANSPORT=resend 时必填
RESEND_API_KEY=

# ---- 内容审核 ----
# off 关闭（仅测试）；rules 启用本地规则引擎。
MODERATION_MODE=rules
# 追加违禁词表文件（每行一条，# 开头为注释）。
# 内置种子词表只是兜底，生产必须按当地法规维护这份外挂词表。
MODERATION_BLOCKLIST_PATH=

# ---- 存储 ----
# 每用户 blob 存储配额（字节），0 表示不限。默认 200MB。
STORAGE_QUOTA_BYTES=209715200
# `bun run db:backup` 的输出目录，策略与恢复演练见 BACKUP.md。
BACKUP_DIR=./data/backups

# ---- 可观测性 ----
# text 人读；json 便于日志采集。
LOG_FORMAT=text
METRICS_ENABLED=1
# 留空则 /metrics 不校验；公网部署务必设置。
METRICS_TOKEN=
# off / console / sentry。sentry 目前只有接口预留，未引入 SDK。
ERROR_REPORTING=off
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ---- 网页 ----
# 桌面端安装包下载地址，网页底部 CTA 与 /download 页用；留空时页面明说未配置。
DOWNLOAD_URL=

# ---- 密码哈希 ----
# argon2id 参数，测试可调低以加速。
PASSWORD_MEMORY_COST=65536
PASSWORD_TIME_COST=2
